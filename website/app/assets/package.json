{
  "name": "misp-modules-website",
  "version": "0.2.0",
  "description": "assets for the flask based front-end to misp-modules",
  "scripts": {
    "build:static": "vite build --config vite.config.mjs",
    "build:editor": "vite build --config vite.editor.config.js",
    "build:markdown": "vite build --config vite.markdown-it.config.js",
    "build:mermaid": "vite build --config vite.mermaid-markdown.config.js",
    "build:all": "npm run build:static && npm run build:editor && npm run build:markdown && npm run build:mermaid"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MISP/misp-modules.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MISP/misp-modules/issues"
  },
  "homepage": "https://github.com/MISP/misp-modules/#readme",
  "devDependencies": {
    "terser": "^5.51.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "linkify-it": "^6.1.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "punycode": "^2.3.1",
    "select2": "^4.1.0",
    "select2-bootstrap-5-theme": "^1.3.0",
    "vue": "^3.5.44",
    "zxcvbn": "^4.4.2"
  },
  "engines": {
    "node": ">=24"
  }
}
